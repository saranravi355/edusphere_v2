# ---------------------------------------------------------------------------
# Database — PostgreSQL
#
# Supabase gives you both URLs under Project Settings -> Database -> Connection
# string. Replace <PROJECT-REF>, <PASSWORD> and <REGION> with your own values.
# The password is URL-encoded, so escape any special characters (@ -> %40 etc).
#
# DATABASE_URL  runtime queries. Use the transaction pooler (port 6543) with
#               pgbouncer=true so serverless functions do not exhaust the
#               connection limit.
# DIRECT_URL    a direct, non-pooled session (port 5432). Prisma Migrate and
#               scripts/port-to-postgres.mjs need this; pgbouncer cannot run
#               the statements they issue.
#
# Moving to the on-premises server later means changing only these two lines,
# for example:
#   DATABASE_URL="postgresql://edusphere:<PASSWORD>@10.0.0.20:5432/edusphere360?schema=public"
#   DIRECT_URL="postgresql://edusphere:<PASSWORD>@10.0.0.20:5432/edusphere360?schema=public"
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"
