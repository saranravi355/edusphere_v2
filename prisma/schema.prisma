generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Runtime connection. On Supabase use the transaction pooler (port 6543)
  // with ?pgbouncer=true so serverless functions do not exhaust connections.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432). Prisma Migrate needs a non-pooled session.
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  /// scrypt$<saltHex>$<hashHex>. No default: a row created without one used to
  /// silently receive the string "password123", which is the whole reason 370
  /// accounts shared a password. Every creation site must now supply a hash.
  password  String
  name      String
  role      String   @default("PARENT")
  /// True until the person has chosen a password of their own. Login sends
  /// these accounts to /change-password and the middleware keeps them out of
  /// every portal until the flag clears.
  ///
  /// Defaults to false because this deployment is a demonstration: every
  /// account shares one password on purpose so the system can be shown without
  /// handing out credentials first. Every creation site sets the value
  /// explicitly from FORCE_PASSWORD_RESET (see src/lib/demo.ts), so flipping
  /// that one environment variable closes the gate again without a schema
  /// change. The column default only decides what a row written by something
  /// that has not read this file gets.
  mustChangePassword Boolean  @default(false)
  /// Null means never changed since the account was made.
  passwordChangedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherProfile   Teacher?
  parentProfile    Parent?
  studentProfile   Student?          @relation("StudentUser")
  messagesSent     Message[]         @relation("Sender")
  messagesRecv     Message[]         @relation("Receiver")
  notifications    Notification[]
  assetCheckouts   AssetCheckout[]
  resourceBookings ResourceBooking[]
  announcements    Announcement[]    @relation("AnnouncementAuthor")
  bookLoans        BookLoan[]
}

model Teacher {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects         String // comma separated or related table
  qualifications   String?
  yearsExperience  Int?
  cpdHours         Int      @default(0)
  
  classes          Classroom[]
  homeworks        Homework[]
  behaviorIncidents BehaviorIncident[]
  clubs            Club[]
  leaveRequests    LeaveRequest[]
  quizzes          Quiz[]
  moderatedQuizzes Quiz[] @relation("ModeratedQuizzes")
  timetable        TimetableEntry[]
  iepCaseloads     IEPPlan[] @relation("IEPCaseloads")
  pdRecords        PDRecord[]
  observations     Observation[] @relation("ObservedTeacher")
  lessonPlans      LessonPlan[]
  substituteCover  LeaveRequest[] @relation("SubstituteCover")
  meetings         ParentTeacherMeeting[]
  baseSalary       Float?         /// monthly gross, in rupees
  payrollLines     PayrollLine[]
  aiGradingSubmissions AIGradingSubmission[]
}

model Parent {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone            String?
  address          String?
  emergencyContact String?
  students         Student[]
  meetings         ParentTeacherMeeting[]
}

model Student {
  id               String       @id @default(cuid())
  registrationNo   String       @unique
  name             String
  dateOfBirth      DateTime?
  gender           String?
  address          String?
  enrollmentDate   DateTime     @default(now())
  emergencyContactName String?
  emergencyContactPhone String?
  curriculum       String       // IB programme: PYP, MYP, or DP
  parentId         String?
  parent           Parent?      @relation(fields: [parentId], references: [id])
  classroomId      String?
  classroom        Classroom?   @relation(fields: [classroomId], references: [id])
  medicalNotes     String?
  bloodGroup       String?
  learningNeeds    String?
  allergies        String?
  flaggedFoods     String?
  isActive         Boolean      @default(true)
  userId           String?      @unique
  user             User?        @relation("StudentUser", fields: [userId], references: [id])
  // New Demographic & Family Fields
  medium           String?
  groupCode        String?
  nationality      String?
  religion         String?
  community        String?
  subCaste         String?
  motherTongue     String?
  motherName       String?
  motherOccupation String?
  motherMonthlyIncome String?
  fatherName       String?
  
  attendances      Attendance[]
  meetings         ParentTeacherMeeting[]
  transport        StudentTransport?
  grades           Grade[]
  homeworkSubmits  HomeworkSubmission[]
  invoices         FeeInvoice[]
  behaviorIncidents BehaviorIncident[]
  walletTransactions WalletTransaction[]
  clubMemberships   ClubMembership[]
  clinicVisits     ClinicVisit[]
  quizAttempts     QuizAttempt[]
  hostelRecord     HostelStudent?
  hostelLeaves     HostelLeave[]
  alumniRecord     Alumni?
  iepPlans         IEPPlan[]
  ibSubjects       IBSubjectRecord[]
  ibCore           IBCoreRecord[]
  assessmentResults AssessmentResult[]
  aiGradingSubmissions AIGradingSubmission[]
}

model Classroom {
  id          String    @id @default(cuid())
  name        String    // e.g., 9A
  gradeLevel  Int       // e.g., 9
  teacherId   String?
  teacher     Teacher?  @relation(fields: [teacherId], references: [id])
  
  students    Student[]
  homeworks   Homework[]
  timetable   TimetableEntry[]
  quizzes     Quiz[]
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id])
}

model Subject {
  id          String    @id @default(cuid())
  name        String    // e.g., Biology
  code        String    @unique
  
  grades      Grade[]
  homeworks   Homework[]
  timetable   TimetableEntry[]
  quizzes     Quiz[]
}

model Attendance {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date           DateTime
  status         String
  session        String   @default("FULL_DAY") // MORNING, AFTERNOON, FULL_DAY
  isMedicalLeave Boolean  @default(false)
  recordedBy     String   // userId
  createdAt      DateTime @default(now())

  /// One mark per student, per register, per day. Without this the table
  /// happily held a child marked PRESENT and ABSENT on the same morning —
  /// three separate call sites each did their own find-then-create, and one
  /// of them ignored `session` and computed "today" from the server's
  /// midnight rather than Bengaluru's. `date` is normalised to midnight UTC
  /// of the IST calendar date by registerDate() in src/lib/attendance.ts, so
  /// this constraint means what it reads like.
  @@unique([studentId, date, session])
}

model Grade {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examName    String
  score       Float
  maxScore    Float
  date        DateTime @default(now())
}

model Homework {
  id            String      @id @default(cuid())
  title         String
  description   String
  dueDate       DateTime
  subjectId     String
  subject       Subject     @relation(fields: [subjectId], references: [id])
  classroomId   String
  classroom     Classroom   @relation(fields: [classroomId], references: [id])
  teacherId     String
  teacher       Teacher     @relation(fields: [teacherId], references: [id])
  attachmentUrl String?
  
  submissions   HomeworkSubmission[]
}

model HomeworkSubmission {
  id            String   @id @default(cuid())
  homeworkId    String
  homework      Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content       String
  attachmentUrl String?
  submittedAt   DateTime @default(now())
  grade         Float?
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("Sender", fields: [senderId], references: [id])
  receiverId  String
  receiver    User     @relation("Receiver", fields: [receiverId], references: [id])
  subject     String
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// PHASE 5: NEW FEATURES

model BehaviorIncident {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  type        String   // MERIT or DEMERIT
  category    String   // e.g., "Disruptive", "Helpful", "Late"
  description String
  points      Int
  date        DateTime @default(now())
}

model WalletTransaction {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  type        String   // TOP_UP or PURCHASE
  amount      Float
  description String   // e.g., "Lunch - Pizza", "Parent Top-up"
  date        DateTime @default(now())
}

model Club {
  id          String   @id @default(cuid())
  name        String
  description String
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  members     ClubMembership[]
  activities  ClubActivity[]
}

model ClubActivity {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title       String
  type        String   // MEETING, COMPETITION, WORKSHOP, TRIP, SERVICE, EVENT
  date        DateTime
  location    String?
  description String?
  outcome     String?  // filled in after the activity, e.g. "Won 2nd place"
}

model ClubMembership {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  joinedAt    DateTime @default(now())
}

model ClinicVisit {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  reason      String
  treatment   String
  notes       String?
  date        DateTime @default(now())
}

model LeaveRequest {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  appliedAt   DateTime @default(now())

  leaveType           String    @default("CASUAL") // CASUAL, SICK, EARNED, UNPAID
  substituteTeacherId String?
  substituteTeacher   Teacher?  @relation("SubstituteCover", fields: [substituteTeacherId], references: [id])
  decidedAt           DateTime?
  decidedById         String?   // userId of the approver
}

model TimetableEntry {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId   String?
  teacher     Teacher?  @relation(fields: [teacherId], references: [id])
  dayOfWeek   Int       // 1 = Monday, 5 = Friday
  period      Int
  startTime   String    // "08:00"
  endTime     String    // "08:45"
  room        String?
}

model FeeInvoice {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  amount      Float
  dueDate     DateTime
  status      String   @default("PENDING") // PENDING, PAID, OVERDUE
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  transactions PaymentTransaction[]
}

model PaymentTransaction {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Float
  method      String   // UPI, CARD
  status      String   @default("SUCCESS")
  createdAt   DateTime @default(now())
}

// PHASE 7: ENTERPRISE MODULES

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  isRead      Boolean  @default(false)
  type        String   @default("INFO") // INFO, ALERT, SUCCESS
  createdAt   DateTime @default(now())
}

model Quiz {
  id          String   @id @default(cuid())
  title       String
  description String?
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  dueDate     DateTime
  createdAt   DateTime @default(now())

  // Exam Engine fields
  examType         String    @default("QUIZ") // UNIT_TEST, MIDTERM, FINAL, QUIZ, PRACTICAL, VIVA, PROJECT
  timeLimitMinutes Int?      // null = untimed
  totalMarks       Int       @default(0)
  status           String    @default("DRAFT") // DRAFT, PUBLISHED, PENDING_MODERATION, MODERATED, GRADES_RELEASED
  moderatedByTeacherId String?
  moderatedByTeacher   Teacher? @relation("ModeratedQuizzes", fields: [moderatedByTeacherId], references: [id])
  moderatedAt      DateTime?
  gradesReleasedAt DateTime?

  questions   Question[]
  attempts    QuizAttempt[]
}

model Question {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text        String
  type        String   @default("MCQ") // MCQ, SHORT_ANSWER, ESSAY
  options     String?  // JSON string of options ["A", "B", "C", "D"], null for essay/short answer
  correctIdx  Int?     // Index of correct option (0-3), null for essay/short answer
  points      Int      @default(1)
  difficulty  String?  // EASY, MEDIUM, HARD
  bloomsLevel String?  // Remember, Understand, Apply, Analyze, Evaluate, Create
  rubricCriteria String? // JSON array of {criterion, maxPoints} for essay/short answer grading

  responses   QuizResponse[]
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score       Int
  totalScore  Int
  submittedAt DateTime @default(now())

  // Exam Engine fields
  startedAt      DateTime?
  autoSubmitted  Boolean   @default(false)
  status         String    @default("SUBMITTED") // IN_PROGRESS, SUBMITTED, GRADED, RELEASED
  questionOrder  String?   // JSON array of question ids in randomized order shown to this student
  violations     Int       @default(0) // lockdown breaches recorded during the sitting

  responses      QuizResponse[]
}

model QuizResponse {
  id            String      @id @default(cuid())
  attemptId     String
  attempt       QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIdx   Int?        // for MCQ
  textAnswer    String?     // for short answer / essay
  marksAwarded  Float?
  rubricScores  String?     // JSON array of {criterion, points} awarded
  feedback      String?
  gradedByTeacherId String?

  @@unique([attemptId, questionId])
}

model Alumni {
  id               String   @id @default(cuid())
  studentId        String   @unique
  student          Student  @relation(fields: [studentId], references: [id])
  graduationYear   Int
  finalProgramme   String   // PYP, MYP, or DP
  finalDpScore     Int?     // out of 45, DP graduates only
  university       String?
  courseOfStudy    String?
  country          String?
  currentStatus    String?  // STUDYING, WORKING, GAP_YEAR, OTHER
  achievements     String?
  linkedinUrl      String?
  isFeatured       Boolean  @default(false) // shown on the achievement wall
  createdAt        DateTime @default(now())
}

model Asset {
  id          String   @id @default(cuid())
  name        String
  category    String   // LAPTOP, IPAD, LAB_EQUIPMENT
  serialNo    String   @unique
  status      String   @default("AVAILABLE") // AVAILABLE, CHECKED_OUT, MAINTENANCE
  createdAt   DateTime @default(now())
  
  checkouts   AssetCheckout[]
}

model AssetCheckout {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])
  userId      String   // Can be student or teacher
  user        User     @relation(fields: [userId], references: [id])
  checkoutDate DateTime @default(now())
  returnDate  DateTime?
  status      String   @default("ACTIVE") // ACTIVE, RETURNED
}

model HostelRoom {
  id          String   @id @default(cuid())
  roomNumber  String   @unique
  block       String
  gender      String   @default("BOYS") // BOYS, GIRLS
  floor       Int?
  warden      String?
  capacity    Int
  type        String   // AC, NON_AC
  occupants   HostelStudent[]
}

model HostelStudent {
  id          String   @id @default(cuid())
  studentId   String   @unique
  student     Student  @relation(fields: [studentId], references: [id])
  roomId      String
  room        HostelRoom @relation(fields: [roomId], references: [id])
  joinedAt    DateTime @default(now())
}

model FeeStructure {
  id          String   @id @default(cuid())
  name        String   // e.g., "Grade 10 Annual Tuition"
  amount      Float
  gradeLevel  String?  // Optional, if it applies to a specific grade
  academicYear String
  createdAt   DateTime @default(now())
}

model Resource {
  id          String   @id @default(cuid())
  name        String   // e.g., "Chemistry Lab 1", "Projector A", "The Great Gatsby"
  type        String   // e.g., "FACILITY", "EQUIPMENT", "LIBRARY_BOOK"
  status      String   @default("AVAILABLE") // AVAILABLE, IN_USE, MAINTENANCE
  capacity    Int?     // For rooms
  bookings    ResourceBooking[]
}

model ResourceBooking {
  id          String   @id @default(cuid())
  resourceId  String
  resource    Resource @relation(fields: [resourceId], references: [id])
  userId      String   // Can be teacher or student
  user        User     @relation(fields: [userId], references: [id])
  startTime   DateTime
  endTime     DateTime
  purpose     String
  status      String   @default("APPROVED") // PENDING, APPROVED, CANCELLED
}

// Learning Needs & IEP (PRD Module 01)

model IEPPlan {
  id             String    @id @default(cuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  caseManagerId  String?
  caseManager    Teacher?  @relation("IEPCaseloads", fields: [caseManagerId], references: [id])
  needType       String    // e.g. Dyslexia, ADHD, Autism Spectrum, Gifted & Talented, EAL
  status         String    @default("ACTIVE") // ACTIVE, UNDER_REVIEW, ARCHIVED
  summary        String
  accommodations String?   // newline-separated list of classroom accommodations
  reviewDate     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  goals          IEPGoal[]
}

model IEPGoal {
  id         String    @id @default(cuid())
  planId     String
  plan       IEPPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  title      String
  targetDate DateTime?
  progress   Int       @default(0) // 0-100
  status     String    @default("IN_PROGRESS") // IN_PROGRESS, ACHIEVED, AT_RISK
  notes      String?
  createdAt  DateTime  @default(now())
}

// Teacher Professional Development & Appraisal (PRD Module 02)

model PDRecord {
  id            String   @id @default(cuid())
  teacherId     String
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title         String
  type          String   // WORKSHOP, CERTIFICATION, COURSE, CONFERENCE
  provider      String?
  hours         Int
  dateCompleted DateTime @default(now())
  notes         String?
}

model Observation {
  id              String   @id @default(cuid())
  teacherId       String
  teacher         Teacher  @relation("ObservedTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  observerName    String
  date            DateTime @default(now())
  className       String?
  focusArea       String?  // e.g. ATL skill integration, Inquiry-based learning
  planningScore   Int      // IB 1-7 scale
  deliveryScore   Int
  engagementScore Int
  assessmentScore Int
  strengths       String?
  growthAreas     String?
  status          String   @default("FINAL") // DRAFT, FINAL
}

// IB Academic Records (criterion-based assessment, DP/MYP)

model IBSubjectRecord {
  id             String  @id @default(cuid())
  studentId      String
  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectName    String  // e.g. "Mathematics: Analysis & Approaches"
  subjectGroup   Int     // IB groups 1-6
  level          String  // HL, SL (DP) or MYP
  currentGrade   Int?    // 1-7
  predictedGrade Int?    // 1-7
  critA          Int?    // MYP criteria 0-8
  critB          Int?
  critC          Int?
  critD          Int?
  teacherComment String?
  term           String  @default("Term 1 2026-27")
}

model IBCoreRecord {
  id              String  @id @default(cuid())
  studentId       String
  student         Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  element         String  // TOK, EE, CAS
  title           String? // EE title / TOK essay title
  status          String  @default("IN_PROGRESS") // NOT_STARTED, IN_PROGRESS, SUBMITTED, COMPLETE
  grade           String? // A-E for TOK/EE
  creativityHours Int     @default(0)
  activityHours   Int     @default(0)
  serviceHours    Int     @default(0)
  reflections     Int     @default(0)
}

model IBExamSession {
  id              String   @id @default(cuid())
  programme       String   // DP, MYP
  session         String   // e.g. "November 2026 Mock", "May 2027"
  subjectName     String
  level           String?  // HL / SL for DP
  paper           String   // Paper 1, Paper 2, Paper 3, On-screen exam, ePortfolio
  date            DateTime
  durationMinutes Int
  room            String?
  notes           String?  // e.g. "Calculator allowed"
}

// Lesson planning with IB curriculum alignment (PRD M01)

model LessonPlan {
  id              String   @id @default(cuid())
  teacherId       String
  teacher         Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title           String
  subjectName     String
  className       String?
  date            DateTime
  durationMinutes Int      @default(60)
  ibUnit          String?  // MYP unit of inquiry / DP syllabus topic
  atlSkills       String?  // comma-separated ATL skill categories
  learnerProfile  String?  // comma-separated IB learner profile attributes
  objectives      String?
  activities      String?
  resources       String?
  assessment      String?  // formative/summative + criteria
  status          String   @default("PLANNED") // DRAFT, PLANNED, DELIVERED
  subPlan         String?  // generated substitute-teacher plan
  createdAt       DateTime @default(now())
}

// Academic calendar with national-calendar sync (PRD M01)

model AcademicEvent {
  id        String    @id @default(cuid())
  title     String
  type      String    // TERM, HOLIDAY, NATIONAL_HOLIDAY, EXAM_WINDOW, EVENT
  startDate DateTime
  endDate   DateTime?
  source    String    @default("SCHOOL") // SCHOOL, NATIONAL, IB
  notes     String?
}

// Subject resources and assessment history (student all-in-one subject view)

model SubjectResource {
  id          String  @id @default(cuid())
  subjectName String  // matches IBSubjectRecord.subjectName
  programme   String  @default("DP") // DP, MYP, PYP
  title       String
  type        String  // NOTES, PAST_PAPER, VIDEO, LINK, WORKSHEET
  description String?
  url         String?
  addedBy     String? // teacher name
  createdAt   DateTime @default(now())
}

model AssessmentResult {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectName String
  title       String   // e.g. "Unit Test 2: Mechanics"
  type        String   // FORMATIVE, SUMMATIVE, MOCK, IA_DRAFT, ORAL
  date        DateTime
  grade       Int      // IB 1-7
  maxGrade    Int      @default(7)
  comment     String?
  term        String   @default("Term 1 2026-27")

  aiGradingSubmission AIGradingSubmission?
}

/// One scanned answer sheet run through the AI grader: the OCR'd text, the
/// full per-question/criterion breakdown, on-paper annotations, and any
/// teacher override — kept in full even after publishing, since
/// AssessmentResult (below) only has room for a single final 1-7 grade and a
/// comment. On "Publish," a summary is written/updated into AssessmentResult
/// so the result shows up in the normal gradebook/reports/student-grades
/// views exactly like a manually-entered grade; assessmentResultId then
/// records which row that was.
model AIGradingSubmission {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId    String
  teacherId      String
  teacher        Teacher  @relation(fields: [teacherId], references: [id])
  subjectName    String
  title          String                 // e.g. "Unit Test 2: Mechanics"
  term           String
  programme      String                 // DP or MYP, at time of grading
  courseworkType String                 // internal-assessment, extended-essay, tok, external-assessment, exam
  fileUrl        String                 // Vercel Blob URL of the uploaded scan
  ocrText        String?  @db.Text
  ocrPages       Json?                  // page images + OCR line boxes, for annotation rendering
  ocrConfidence  Float?
  result         Json                   // full GradingResult shape: questions, criteria, annotations, feedback
  totalScore     Int
  maxTotal       Int
  providerUsed   String?                // "groq" | "openai", for troubleshooting
  status         String   @default("EVALUATED")
  // OCR_PROCESSING, EVALUATING, EVALUATED, NEEDS_REVIEW, FAILED, PUBLISHED
  errorMessage   String?

  teacherOverrideScore          Int?
  teacherOverrideQuestionScores Json?
  teacherFeedback String?

  assessmentResultId String?  @unique
  assessmentResult   AssessmentResult? @relation(fields: [assessmentResultId], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([teacherId, classroomId])
  @@index([studentId])
}

model FeeItem {
  id           String   @id @default(cuid())
  academicYear String   @default("2025-26")
  gradeBand    String   // Toddler, PREKG-LKG, UKG, 1-5, 6-8, 9, 10, General
  category     String   // Tuition, Annual Material, Registration, Uniform Kit, Lab, Bus, etc.
  amount       Float    // per-installment amount
  installments Int      @default(1) // number of terms/installments (x3, x2, x1)
  mandatory    Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
}

model MenuItem {
  id          String   @id @default(cuid())
  dayOfWeek   Int      // 1 = Monday ... 5 = Friday
  mealType    String   // BREAKFAST, LUNCH, SNACK
  name        String
  description String?
  allergens   String?  // comma-separated: Nuts, Dairy, Gluten, Egg, ...
  isVeg       Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model HostelLeave {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromDate     DateTime
  toDate       DateTime
  reason       String
  destination  String?
  contactPhone String?
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED, RETURNED
  createdAt    DateTime @default(now())
}

/// School-wide announcements.
///
/// The admin dashboard has had a "School-Wide Announcement" dialog since the
/// beginning. Its action slept for a second and returned `{ success: true }`;
/// the title and message were discarded and the "Notify Teachers" / "Notify
/// Parents" checkboxes had no name attribute, so they never reached the server
/// either. This is the record that dialog should always have been writing, and
/// the fan-out to Notification rows is what makes the checkboxes mean anything.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  audience  String   @default("ALL") // ALL, TEACHERS, PARENTS, STUDENTS
  authorId  String
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  sentCount Int      @default(0) // how many people it actually reached
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A booked parent-teacher consultation.
///
/// /parent/meetings presented a full booking flow — a teacher list, a date
/// picker, four time slots with one struck through as "taken", and a Confirm
/// Booking button — none of which had a handler, and an "upcoming meeting" with
/// a named teacher and a generated Zoom link that was hardcoded JSX.
model ParentTeacherMeeting {
  id         String   @id @default(cuid())
  parentId   String
  parent     Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  durationMinutes Int      @default(15)
  status     String   @default("BOOKED") // BOOKED, CANCELLED, COMPLETED
  topic      String?
  createdAt  DateTime @default(now())

  /// One booking per teacher per slot — the database, not the UI, is what stops
  /// two parents taking the same fifteen minutes.
  @@unique([teacherId, scheduledAt])
  @@index([parentId])
}

/// A campus.
///
/// /admin/schools rendered two campuses — "1250 students", "840 students",
/// both Active — from a hardcoded array, with an "+ Add Campus" button and a
/// "Manage Settings" button that had no handlers. There was no School model at
/// all. Classrooms belong to a campus now, so the enrolment figure on each card
/// is a count rather than a number somebody typed.
model School {
  id            String      @id @default(cuid())
  name          String
  campusCode    String      @unique
  address       String?
  phone         String?
  email         String?
  principalName String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  classrooms    Classroom[]
}

/// A school bus route.
///
/// /admin/transport showed "24/26 active vehicles", 24 drivers, one alert and
/// three named routes with ETAs — all a literal array in the page, with a
/// "Track" button that had no handler. /parent/transport/live animated a bus
/// down a CSS road with a setInterval counting an ETA down from 12 minutes.
/// There was no transport model of any kind.
model TransportRoute {
  id            String             @id @default(cuid())
  name          String             @unique
  vehicleNumber String
  driverName    String
  driverPhone   String?
  capacity      Int                @default(40)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())

  stops         TransportStop[]
  riders        StudentTransport[]
}

model TransportStop {
  id         String             @id @default(cuid())
  routeId    String
  route      TransportRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name       String
  /// School-local HH:mm. Stored as text because it is a time of day, not an instant.
  pickupTime String
  dropTime   String?
  sequence   Int

  riders     StudentTransport[]

  @@unique([routeId, sequence])
}

model StudentTransport {
  id        String         @id @default(cuid())
  studentId String         @unique
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  routeId   String
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopId    String?
  stop      TransportStop? @relation(fields: [stopId], references: [id])
  createdAt DateTime       @default(now())

  @@index([routeId])
}

/// The library catalogue.
///
/// /student/library listed four hardcoded books with a dead search box, a dead
/// subject filter and a download button with no href. /admin/library was
/// replaced earlier in this project with an honest "not built yet" notice
/// precisely because there was no model behind it. This is that model.
model LibraryBook {
  id          String     @id @default(cuid())
  title       String
  author      String
  isbn        String?    @unique
  category    String     @default("GENERAL")
  subjectName String?
  copiesTotal Int        @default(1)
  createdAt   DateTime   @default(now())

  loans       BookLoan[]

  @@index([title])
}

model BookLoan {
  id         String      @id @default(cuid())
  bookId     String
  book       LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  borrowedAt DateTime    @default(now())
  dueDate    DateTime
  returnedAt DateTime?
  status     String      @default("ACTIVE") // ACTIVE, RETURNED

  @@index([bookId, status])
  @@index([userId, status])
}

/// A month's payroll.
///
/// /admin/finance/payroll had a cycle dropdown with no name and no handler, a
/// "Run Payroll Batch" button that was a 2.5-second setTimeout followed by
/// three hardcoded staff rows and a hardcoded "₹2,45,600 across 85 Staff
/// Members", and "Disburse Funds" and "Export CSV" buttons with no onClick. A
/// banner claimed it was "Syncing with Leave Module to calculate UTO
/// deductions"; nothing was read from the leave module. There was no payroll
/// model.
model PayrollRun {
  id          String        @id @default(cuid())
  /// yyyy-mm, e.g. "2026-08". One run per month.
  period      String        @unique
  status      String        @default("DRAFT") // DRAFT, DISBURSED
  totalNet    Float         @default(0)
  runById     String
  createdAt   DateTime      @default(now())
  disbursedAt DateTime?

  lines       PayrollLine[]
}

model PayrollLine {
  id         String     @id @default(cuid())
  runId      String
  run        PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  teacherId  String
  teacher    Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  baseSalary Float
  /// Working days of unpaid leave in the period, read from LeaveRequest.
  unpaidDays Int        @default(0)
  deductions Float      @default(0)
  netPay     Float

  @@unique([runId, teacherId])
}

/// A PYP unit of inquiry.
///
/// /admin/programmes drew six transdisciplinary theme bars with done/total
/// counts from a PYP_THEMES literal, and a "units of inquiry completed" stat to
/// match — sitting next to real DP and MYP figures pulled from the database.
model PYPUnit {
  id          String    @id @default(cuid())
  theme       String    // Who We Are, How We Express Ourselves, ...
  title       String
  gradeLevel  String
  status      String    @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETE
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  @@index([theme])
}

/// Who did what, and when.
///
/// The application had no answer to that question at all: a role could be
/// changed, a fee written off, an account created or a password reset with no
/// record beyond the row it altered. For a school holding 173 children's
/// records that is not an engineering gap, it is a safeguarding one — the
/// first thing anyone asks after an incident is who had access and what they
/// touched.
///
/// Append-only by convention. Nothing in the application updates or deletes a
/// row here; a retention sweep, when there is one, should be a documented job
/// and should itself write a row saying what it removed.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())

  /// Denormalised on purpose. The actor's account may later be renamed,
  /// have its role changed, or be deleted outright, and an audit entry that
  /// reads "role changed by (deleted user)" answers nothing.
  actorId    String?
  actorEmail String?
  actorRole  String?

  /// Machine-readable verb, e.g. SIGN_IN, SIGN_IN_FAILED, PASSWORD_CHANGED,
  /// PASSWORD_RESET, ACCOUNT_CREATED, ROLE_CHANGED.
  action     String
  /// The kind of thing acted on ("User", "FeeInvoice", ...) and its id.
  entity     String?
  entityId   String?

  /// One sentence, written for a human reading the log a year from now.
  summary    String
  /// Anything structured worth keeping, as a short JSON string. Never a
  /// password, a hash, or a session token.
  detail     String?

  @@index([at])
  @@index([actorId, at])
  @@index([entity, entityId])
  @@index([action, at])
}
